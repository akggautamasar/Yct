[Unit]
Description=YCT Driver FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/Yct
EnvironmentFile=/home/ubuntu/.config/yct-driver/env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/apps/Yct/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
