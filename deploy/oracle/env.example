# Copy to /home/ubuntu/.config/yct-driver/env (chmod 600).
# Do not commit the filled-in version.
YCT_EMAIL=
YCT_PASSWORD=
TG_TOKEN=
TG_CHAT_ID=
TG_WEBHOOK_SECRET=
SITE_PASSWORD=
WORK_DIR=/home/ubuntu/data/yct-driver/work
CHECKPOINT_SQLITE_PATH=/home/ubuntu/data/yct-driver/checkpoints/uploads.sqlite3
# During migration only, optionally enable legacy GitHub lookup:
# CHECKPOINT_GITHUB_TOKEN=
# CHECKPOINT_GITHUB_REPO=akggautamasar/Yct
CHUNK_PAGES=100
MAX_WORKERS=3
TG_MAX_MB=45
DO_OCR=false
OCR_LANG=hin+eng
